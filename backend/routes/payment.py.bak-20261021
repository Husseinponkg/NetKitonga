from typing import Any, Dict, List

from fastapi import APIRouter, Body, HTTPException, Query, status

from controllers.payments import PaymentController
from models.payments import (
    CheckoutRequest,
    PaymentHistoryResponse,
    PortalBuyerRequest,
)
from services.payments import PaymentService


payment_endpoints = APIRouter(
    prefix="/payments",
    tags=["AzamPay Micro-Billing Engine"],
)

service = PaymentService()
controller = PaymentController()


# ============================================================
# AZAMPAY DIAGNOSTIC
# ============================================================

@payment_endpoints.get("/azampay/diagnostic")
async def handle_azampay_diagnostic() -> Dict[str, Any]:
    """
    Check AzamPay authentication and configuration.

    This endpoint does not initiate a payment.
    Never return API keys, passwords, or bearer tokens.
    """

    auth_ok = False
    auth_error = None

    try:
        token = service._get_bearer_token()
        auth_ok = bool(token)

    except Exception as err:
        auth_error = str(
            getattr(
                err,
                "detail",
                "AzamPay authentication check failed.",
            )
        )[:300]

    return {
        "auth_url": service.auth_url,
        "checkout_url": service.checkout_url,
        "auth_ok": auth_ok,
        "auth_error": auth_error,
        "checkout_configured": bool(
            service.checkout_url and service.api_key
        ),
        "checkout_test_performed": False,
        "message": (
            "Authentication succeeded. Checkout has not been tested."
            if auth_ok
            else (
                "Authentication failed. Check the server logs "
                "and AzamPay sandbox configuration."
            )
        ),
    }


# ============================================================
# MOBILE MONEY CHECKOUT
# ============================================================

@payment_endpoints.post(
    "/checkout",
    response_model=Dict[str, Any],
    status_code=status.HTTP_200_OK,
)
async def handle_checkout_trigger(
    payload: CheckoutRequest,
) -> Dict[str, Any]:
    """
    Initiate mobile-money checkout from the captive portal.

    A successful API response does not necessarily mean
    that the customer has completed payment.
    """

    return await service.initiate_mno_checkout(payload)


# ============================================================
# CAPTIVE PORTAL BUYER REGISTRATION
# ============================================================

@payment_endpoints.post(
    "/portal/buyer",
    response_model=Dict[str, int],
    status_code=status.HTTP_200_OK,
)
async def handle_portal_buyer(
    payload: PortalBuyerRequest,
) -> Dict[str, int]:
    """Register a buyer using the captive portal."""

    buyer_id = await service.register_portal_buyer(payload)

    return {
        "buyer_id": buyer_id,
    }


# ============================================================
# CAPTIVE PORTAL PAYMENT STATUS
# ============================================================

@payment_endpoints.get("/status")
async def handle_portal_payment_status(
    gateway_reference: str = Query(...),
    router_id: int = Query(...),
    buyer_mac: str = Query(...),
) -> Dict[str, Any]:
    """
    Retrieve payment status for a captive portal transaction.
    """

    return await controller.get_portal_payment_status(
        gateway_reference,
        router_id,
        buyer_mac,
    )


# ============================================================
# PAYMENT HISTORY
# ============================================================

@payment_endpoints.get(
    "/history",
    response_model=List[PaymentHistoryResponse],
)
async def handle_get_payment_ledger(
    tenant_id: int = Query(
        ...,
        description="The active business tenant ID context",
    ),
) -> List[PaymentHistoryResponse]:
    """Return the payment history for a tenant."""

    return await service.get_tenant_payment_history(tenant_id)


# ============================================================
# TENANT INCOME STATISTICS
# ============================================================

@payment_endpoints.get("/income/stats")
async def handle_get_income_stats(
    tenant_id: int = Query(...),
) -> Dict[str, Any]:
    """Return aggregated income statistics for a tenant."""

    return await service.get_tenant_income_stats(tenant_id)


# ============================================================
# AZAMPAY CALLBACK / WEBHOOK
# ============================================================

@payment_endpoints.post("/webhook/callback")
async def handle_azampay_gateway_callback(
    payload: Dict[str, Any] = Body(...),
) -> Dict[str, Any]:
    """
    Process an asynchronous AzamPay payment callback.

    Supports several possible reference and status field names.

    IMPORTANT:
    Confirm the actual callback format and terminal status values
    against AzamPay's documentation or a genuine callback sample.

    Unknown statuses are rejected. They are never assumed to mean
    successful payment.
    """

    # --------------------------------------------------------
    # 1. Validate the incoming payload
    # --------------------------------------------------------

    if not isinstance(payload, dict) or not payload:
        print(
            "AzamPay callback rejected: "
            "empty or invalid payload."
        )

        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="Empty or invalid AzamPay callback payload.",
        )

    # --------------------------------------------------------
    # 2. Identify the transaction data
    # --------------------------------------------------------

    callback_data: Dict[str, Any] = payload

    # Support a callback where transaction fields are nested
    # inside a dictionary called "data".
    if isinstance(payload.get("data"), dict):
        callback_data = payload["data"]

    # Log field names only to avoid exposing personal information
    # or sensitive transaction values in application logs.
    print("========== AZAMPAY CALLBACK ==========")
    print(
        "Callback top-level fields:",
        list(payload.keys()),
    )
    print(
        "Callback transaction fields:",
        list(callback_data.keys()),
    )

    # --------------------------------------------------------
    # 3. Extract the external transaction reference
    # --------------------------------------------------------

    reference_fields = (
        "externalId",
        "external_id",
        "externalreference",
        "externalReference",
        "external_reference",
    )

    external_id = next(
        (
            callback_data.get(key)
            for key in reference_fields
            if isinstance(callback_data.get(key), str)
            and callback_data[key].strip()
        ),
        None,
    )

    # --------------------------------------------------------
    # 4. Extract the transaction status
    # --------------------------------------------------------

    status_fields = (
        "transactionStatus",
        "transactionstatus",
        "transaction_status",
        "status",
    )

    raw_status = next(
        (
            callback_data.get(key)
            for key in status_fields
            if isinstance(callback_data.get(key), str)
            and callback_data[key].strip()
        ),
        None,
    )

    print(
        "Callback reference received:",
        bool(external_id),
    )
    print(
        "Callback transaction status:",
        raw_status,
    )
    print("======================================")

    # --------------------------------------------------------
    # 5. Validate the external transaction reference
    # --------------------------------------------------------

    if not isinstance(external_id, str) or not external_id.strip():
        print(
            "AzamPay callback rejected: "
            "missing external transaction reference."
        )

        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail=(
                "Missing external transaction reference "
                "in AzamPay callback."
            ),
        )

    external_id = external_id.strip()

    # --------------------------------------------------------
    # 6. Validate the transaction status
    # --------------------------------------------------------

    if not isinstance(raw_status, str) or not raw_status.strip():
        print(
            "AzamPay callback rejected: "
            "missing transaction status."
        )

        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail=(
                "Missing transaction status "
                "in AzamPay callback."
            ),
        )

    transaction_status = raw_status.strip().lower()

    # --------------------------------------------------------
    # 7. Recognize final transaction statuses
    # --------------------------------------------------------

    success_statuses = {
        "success",
        "successful",
        "completed",
        "paid",
    }

    failure_statuses = {
        "failed",
        "failure",
        "unsuccessful",
        "cancelled",
        "canceled",
        "rejected",
    }

    if transaction_status in success_statuses:
        is_successful = True

    elif transaction_status in failure_statuses:
        is_successful = False

    else:
        # Pending, processing, and unknown statuses must not
        # be interpreted as successful payments.
        print(
            "AzamPay callback rejected: "
            "unrecognized transaction status:",
            transaction_status,
        )

        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="Unrecognized AzamPay transaction status.",
        )

    # --------------------------------------------------------
    # 8. Process the transaction
    # --------------------------------------------------------

    try:
        acknowledged = await controller.process_asynchronous_callback(
            external_id,
            is_successful,
        )

    except Exception:
        # Do not expose internal errors or database credentials
        # in the public webhook response.
        print(
            "AzamPay callback processing raised an exception."
        )

        raise HTTPException(
            status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
            detail="Unable to process AzamPay callback.",
        )

    if not acknowledged:
        print(
            "AzamPay callback could not be processed. "
            "The reference was not found or processing failed."
        )

        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail=(
                "Callback transaction reference was not found "
                "or could not be processed."
            ),
        )

    # --------------------------------------------------------
    # 9. Acknowledge the callback
    # --------------------------------------------------------

    return {
        "status": "acknowledged",
        "code": 200,
    }
